# ==============================================================================
# FPL ASSISTANT (2026/2027) ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (development | production)
APP_ENV=development
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Backend Configuration (Go Core)
# ------------------------------------------------------------------------------
# Port for the local Go HTTP / JSON-RPC server
PORT=18492
BACKEND_PORT=18492

# Official Fantasy Premier League API Base URL
FPL_BASE_URL=https://fantasy.premierleague.com/api

# Custom User-Agent header for official FPL endpoints
FPL_USER_AGENT=FPL-Assistant-Desktop/1.0 (Go; Windows)

# Cache TTL for global bootstrap data (in minutes)
CACHE_TTL_MINUTES=60

# ------------------------------------------------------------------------------
# MySQL (optional L2 cache + persistence). Set DB_ENABLED=false to skip.
# ------------------------------------------------------------------------------
DB_ENABLED=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fpl_assistant

# ------------------------------------------------------------------------------
# Frontend Configuration (Electron & Vite)
# ------------------------------------------------------------------------------
# Base URL to reach the Go Backend from Electron / Web
VITE_BACKEND_URL=http://127.0.0.1:18492
VITE_BACKEND_PORT=18492

# Default Team ID loaded on initial application startup (optional)
VITE_DEFAULT_TEAM_ID=12345

# Open Chromium DevTools automatically in Electron window
ELECTRON_DEV_TOOLS=false
